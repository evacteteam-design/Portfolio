# Required for live AI generation. Create a key at https://platform.openai.com/api-keys.
# A secret key starts with sk- and is shown only once, so copy it right away.
# Keep this server-side; never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Add your key to .env.local and restart the dev server, or set it on your host and redeploy.
# OpenAI API billing is separate from ChatGPT subscriptions.
# Visitors share this key, so also set a hard monthly spend limit on its OpenAI project:
# https://developers.openai.com/api/docs/guides/spend-limits
#
# Optional. Defaults to gpt-5-mini.
# Any override must support the Responses API, strict structured outputs,
# and reasoning.effort="medium". Use an API model ID, not a Copilot model label.
# Model documentation: https://developers.openai.com/api/docs/models/gpt-5-mini
OPENAI_MODEL=

# Optional usage caps. Each whole number counts one generation attempt per 24 hours.
# UX_ARCHITECT_VISITOR_LIMIT: per visitor, identified by IP address (an IPv6 visitor's whole /64
# counts as one). Defaults to 10.
# UX_ARCHITECT_DAILY_LIMIT: across all visitors combined. Defaults to 100. Use 0 to pause generation.
# `next dev` doesn't apply the caps, so it only answers localhost (npm run dev binds to 127.0.0.1).
# To try the caps locally, run `npm run build` and `npm start` with the Upstash variables below, or
# with UX_ARCHITECT_ALLOW_MEMORY_STORE=1.
UX_ARCHITECT_VISITOR_LIMIT=
UX_ARCHITECT_DAILY_LIMIT=

# Shared storage for the caps above. REQUIRED in production: every serverless instance otherwise
# keeps its own count and loses it on restart, so the caps wouldn't hold. Without it, generation
# stays switched off (503) rather than running uncapped. On Vercel, set it for Production and Preview.
# Create a free Redis database at https://console.upstash.com and copy its REST URL and token.
# Integrations that name them KV_REST_API_URL and KV_REST_API_TOKEN are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only for one long-lived server you run yourself, never serverless or Vercel: set to 1 to keep the
# caps in memory instead of Upstash. Counts reset on restart and aren't shared between instances.
UX_ARCHITECT_ALLOW_MEMORY_STORE=
